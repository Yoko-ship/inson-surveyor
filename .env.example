APP_ENV=development
DATA_MODE=synthetic
HOSTING_COUNTRY=local
DATABASE_URL=sqlite:///./data/surveyor.db
STORAGE_DIR=./data/uploads
PUBLIC_URL=http://localhost:8010
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_EXPECTED_BOT_ID=
TELEGRAM_WEBHOOK_SECRET=
PDF_FONT_PATH=
PORT=8010

# Local worker: verified daily SQLite + document backups, retained for 14 days.
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=14

# Optional personal Codex pilot: localhost + synthetic mode + admin only.
# Uses the existing Codex ChatGPT sign-in and only three built-in fictional samples.
# Prompts/images are processed in the cloud and count toward your Codex usage.
CODEX_LOCAL_PILOT=false
# Usually discovered automatically from the Codex desktop installation.
CODEX_CLI_PATH=

# Optional Telegram connection, using Codex on this computer.
# Requires HTTPS, secure cookies and matching signed Telegram launch data.
# Access scope is code-owned: ai/defaults.json telegram_access (owner / linked_users).
# Keep the subscription owner ID configured; staff link their own Telegram accounts.
# Selected documents are sent only after each requesting user consents.
CODEX_TELEGRAM_ENABLED=false
CODEX_TELEGRAM_OWNER_ID=

# AI prompts and provider selection are code-owned: surveyor/ai/defaults.json.
# Optional alternative. Only a local loopback Ollama server is accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional HTTPS Compose override; set this when choosing an always-on host.
APP_DOMAIN=
